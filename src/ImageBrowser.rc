// ImageBrowser.rc : resources for ImageBrowser - ClassRonin
//
// Upstream shipped eight dialog templates, four menus, a help viewer and a string table for the
// full ImageBrowser UI. None of it exists any more: the only resources this application needs are the
// executable icon and a version block, so file managers and "Properties" have something to show.

#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// The icon with the lowest ID value must be first so the shell picks it for the executable.
IDR_MAINFRAME           ICON                    "res\\ImageBrowser.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ImageBrowser - ClassRonin"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ImageBrowser"
            VALUE "LegalCopyright", "GPL v2. Copyright 2020-2023 Kevin M (sylikc), 2006-2018 David Kleiner. Derivative work, see LICENSE.txt."
            VALUE "OriginalFilename", "ImageBrowser.exe"
            VALUE "ProductName", "ImageBrowser - ClassRonin"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "ImageBrowser - ClassRonin"
END
